# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and auto-loaded by Wi-Fi hardware test scripts.

HOSTCTL_NET_PORT="<serial-port>"
HOSTCTL_NET_BAUD="115200"

HOSTCTL_NET_SSID="<wifi-ssid>"
HOSTCTL_NET_PASSWORD="<wifi-password>"

HOSTCTL_NET_POLICY_PATH="./tools/hostctl/scenarios/wifi-policy.default.json"
HOSTCTL_NET_DISCOVERY_PROFILE_PATH="./tools/hostctl/scenarios/wifi-discovery-debug.default.toml"
HOSTCTL_NET_LOG_PATH="./logs/wifi_manual.log"

# Optional Wi-Fi/upload regression guardrails.
# Enforce one host workflow per port via lock file.
HOSTCTL_NET_LOCK_PATH="./logs/locks/wifi_default.lock"
HOSTCTL_NET_LOCK_WAIT_SEC="0"
HOSTCTL_NET_ALLOW_LOG_APPEND="0"
HOSTCTL_NET_ENFORCE_POLICY_FLOORS="1"

# Optional panic-first regression gate controls.
HOSTCTL_NET_SOAK_CYCLES="0"
HOSTCTL_NET_PANIC_AUTO_TROUBLESHOOT="1"
HOSTCTL_NET_PANIC_CONTEXT_LINES="80"
# HOSTCTL_NET_PANIC_EXCERPT_PATH="./logs/panic_excerpt.log"
# HOSTCTL_NET_REGRESSION_REPORT_PATH="./logs/wifi_regression_report.json"

# Optional stack-risk CI threshold (bytes for [u8; N] guards).
STACK_RISK_LOCAL_ARRAY_MAX_BYTES="4096"

# SonarQube local scan token (used by scripts/ci/sonar_scan.sh)
SONAR_TOKEN="<sonarqube-token>"
