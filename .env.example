# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and auto-loaded by Wi-Fi hardware test scripts.

HOSTCTL_NET_PORT="<serial-port>"
HOSTCTL_NET_BAUD="115200"

HOSTCTL_NET_SSID="<wifi-ssid>"
HOSTCTL_NET_PASSWORD="<wifi-password>"

# Policy template is hard-coded in hostctl (tools/hostctl/scenarios/wifi-policy.default.json);
# stage logs default to timestamped logs/wifi_*.log.

# Optional overrides (omit to use command defaults or disable optional features):
#   HOSTCTL_PORT / HOSTCTL_BAUD / HOSTCTL_PORT_HINT            # generic serial
#   HOSTCTL_LOG_JSON_PATH                                      # structured host log
#   HOSTCTL_NET_TARGET                                         # acceptance target selection
#   HOSTCTL_NET_LOG_PATH                                       # stage log routing
#   HOSTCTL_NET_CYCLES / HOSTCTL_NET_SOAK_CYCLES               # acceptance/soak length
#   HOSTCTL_NET_ALLOW_LOG_APPEND / HOSTCTL_NET_LOCK_WAIT_SEC    # rerun/lock-wait switches
#   HOSTCTL_NET_SKIP_HOST_WIFI_CHECK                            # CI container without SSID match
#   HOSTCTL_UPLOAD_TOKEN                                        # device-side auth when enabled
#   HOSTCTL_UPLOAD_MODE / HOSTCTL_UPLOAD_CHUNK_SIZE              # documented tuning
#   HOSTCTL_UPLOAD_CONNECT_TIMEOUT_SEC                         # connection timeout, default 4 seconds
#   HOSTCTL_UPLOAD_SEND_DIAG / HOSTCTL_UPLOAD_SEND_DIAG_DEEP / HOSTCTL_UPLOAD_SEND_DIAG_PATH
#   HOSTCTL_NET_PANIC_AUTO_TROUBLESHOOT / HOSTCTL_NET_REGRESSION_OUTPUT_DIR
#   HOSTCTL_EXPERIMENT_NOVELTY_GUARD / HOSTCTL_EXPERIMENT_NOVELTY_OVERRIDE
#   HOSTCTL_HOST_RUSTUP_TOOLCHAIN
#   HOSTCTL_FLASH_CAPTURE_LOG_PATH / HOSTCTL_FLASH_CAPTURE_MODE
#   HOSTCTL_FLASH_CAPTURE_FLASH_MODE / HOSTCTL_FLASH_CAPTURE_IMAGE
#   HOSTCTL_FLASH_CAPTURE_BOOT_TARGET / HOSTCTL_FLASH_CAPTURE_BOOT_WINDOW_MS
#   HOSTCTL_FLASH_CAPTURE_POST_COMMAND / HOSTCTL_FLASH_CAPTURE_POST_PATTERN
#   HOSTCTL_FLASH_CAPTURE_POST_TIMEOUT_MS                       # wrapper options forwarded as CLI flags
# Hard-coded (not overridable via env): wifi-policy.default.json template, lock
# path, policy-floor enforcement, panic excerpt/report paths, and all
# retry budgets and decided transport settings. The supported upload options
# above remain configurable (see docs/references/hostctl.md).

# Optional stack-risk CI threshold (bytes for [u8; N] guards).
STACK_RISK_LOCAL_ARRAY_MAX_BYTES="4096"
